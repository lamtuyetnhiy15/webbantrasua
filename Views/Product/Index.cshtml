@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const track = document.getElementById('bestsellerTrack');
            const btnPrev = document.getElementById('btnPrevBestSeller');
            const btnNext = document.getElementById('btnNextBestSeller');

            function getScrollAmount() {
                const card = track ? track.querySelector('.bestseller-card-col') : null;
                return card ? (card.offsetWidth + 24) : 300;
            }

            if (track && btnNext) {
                btnNext.addEventListener('click', function () {
                    track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
                });
            }

            if (track && btnPrev) {
                btnPrev.addEventListener('click', function () {
                    track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
                });
            }

            // Kéo chuột qua trái/phải để xem tiếp các món (Mouse drag)
            if (track) {
                let isDown = false;
                let startX = 0;
                let scrollLeft = 0;
                let hasDragged = false;

                track.addEventListener('mousedown', (e) => {
                    isDown = true;
                    hasDragged = false;
                    track.classList.add('grabbing');
                    startX = e.pageX - track.offsetLeft;
                    scrollLeft = track.scrollLeft;
                });

                track.addEventListener('mouseleave', () => {
                    isDown = false;
                    track.classList.remove('grabbing');
                });

                track.addEventListener('mouseup', () => {
                    isDown = false;
                    track.classList.remove('grabbing');
                    setTimeout(() => { hasDragged = false; }, 60);
                });

                track.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - track.offsetLeft;
                    const walk = (x - startX) * 1.3;
                    if (Math.abs(walk) > 5) {
                        hasDragged = true;
                    }
                    track.scrollLeft = scrollLeft - walk;
                });

                // Chặn mở link nếu người dùng đang thao tác kéo chuột
                track.addEventListener('click', (e) => {
                    if (hasDragged) {
                        e.preventDefault();
                        e.stopPropagation();
                        hasDragged = false;
                    }
                }, true);
            }
        });
    </script>
}
