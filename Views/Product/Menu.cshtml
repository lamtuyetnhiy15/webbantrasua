@model IEnumerable<WebTraSua.Models.Product>

@{
    ViewData["Title"] = "Menu Trà Sữa TN Tea";
    var selectedCat = (string?)ViewBag.SelectedCategory ?? "all";
    var searchTerm = (string?)ViewBag.SearchTerm ?? "";

    // Danh sách các danh mục sản phẩm (dễ dàng bổ sung thêm danh mục sau này)
    var categories = new List<(string Key, string Name, string Icon)>
    {
        ("all", "Tất Cả Sản Phẩm", "bi bi-grid-fill"),
        ("trasua", "Trà Sữa Đậm Hương", "bi bi-cup-hot-fill"),
        ("truyenthong", "Trà Sữa Truyền Thống", "bi bi-cup-straw"),
        ("cheese", "Cheese & Matcha", "bi bi-stars")
    };

    var currentCatKey = (selectedCat == "tratraicay" ? "truyenthong" : selectedCat);
    var currentCat = categories.FirstOrDefault(c => c.Key == currentCatKey);
    var currentCatName = currentCat.Name != null ? currentCat.Name : "Tất Cả Sản Phẩm";
}

<div class="menu-hero-section position-relative overflow-hidden mb-4">
    <div class="container py-4 text-center">
        <span class="badge rounded-pill px-3 py-1 text-uppercase mb-2" style="background-color: var(--nn-soft-pink); color: var(--nn-deep-rose); font-weight: 700; font-size: 0.75rem; letter-spacing: 1.5px;">
            Menu Tuyển Chọn
        </span>
        <h1 class="display-6 font-serif fw-bold mb-2" style="color: var(--nn-plum-text);">Menu Trà Sữa TN Tea</h1>
        <div class="sakura-divider"></div>
        <p class="text-secondary mx-auto mb-0" style="max-width: 650px; font-size: 0.95rem; line-height: 1.7;">
            Trải nghiệm hương vị trà sữa đậm hương thanh mát, kết hợp cùng các loại topping thượng hạng chuẩn phong cách hoàng gia.
        </p>
    </div>
</div>

<div class="container mb-5">
    <!-- THANH CÔNG CỤ TÌM KIẾM & DANH MỤC NHỎ GỌN -->
    <div class="card border-0 rounded-pill shadow-sm px-3 py-2 mb-4 d-flex flex-row justify-content-between align-items-center flex-wrap gap-2" style="background: #FFFFFF; border: 1px solid var(--nn-card-border) !important;">
        <!-- Form tìm kiếm nhỏ gọn -->
        <form asp-controller="Product" asp-action="Menu" method="get" class="d-flex" style="width: 320px; max-width: 100%;">
            <input type="hidden" name="category" value="@selectedCat" />
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 rounded-start-pill text-muted ps-3 py-1">
                    <i class="bi bi-search small text-danger"></i>
                </span>
                <input type="text" name="search" value="@searchTerm" 
                       class="form-control border-start-0 border-end-0 py-1 shadow-none" 
                       style="font-size: 0.875rem; background: transparent;" 
                       placeholder="Tìm món trà sữa..." />
                <button class="btn btn-sakura-primary rounded-end-pill px-3 py-1" 
                        style="font-size: 0.825rem;" type="submit">Tìm</button>
            </div>
        </form>

        <!-- Ô Sổ Danh Mục nhỏ gọn nằm bên phải -->
        <div class="dropdown ms-auto">
            <button class="btn btn-sakura-outline rounded-pill px-3 py-1.5 fw-semibold dropdown-toggle d-inline-flex align-items-center gap-2 shadow-sm" 
                    type="button" id="categoryDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                    style="border-color: var(--nn-primary-pink); font-size: 0.85rem; width: auto; white-space: nowrap;">
                <i class="bi bi-funnel-fill text-danger small"></i>
                <span class="text-secondary small fw-normal">Danh mục:</span>
                <span class="fw-bold" style="color: var(--nn-plum-text);">@currentCatName</span>
                <i class="bi bi-chevron-down text-danger ms-1" style="font-size: 0.72rem;"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2" 
                aria-labelledby="categoryDropdown" style="min-width: 240px; font-size: 0.875rem; z-index: 1050;">
                <li class="px-2 py-1 text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.7rem;">
                    Chọn Danh Mục Món
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                @foreach (var cat in categories)
                {
                    var isActive = (currentCatKey == cat.Key);
                    <li>
                        <a class="dropdown-item rounded-3 py-1.5 px-2.5 fw-semibold d-flex align-items-center justify-content-between @(isActive ? "active-sakura" : "")" 
                           asp-action="Menu" asp-route-category="@cat.Key" asp-route-search="@searchTerm">
                            <span class="d-flex align-items-center gap-2">
                                <i class="@cat.Icon text-danger small"></i>
                                <span>@cat.Name</span>
                            </span>
                            @if (cat.Key == "all")
                            {
                                <span class="badge rounded-pill bg-light text-secondary border small">@(ViewBag.TotalAllItems ?? Model.Count())</span>
                            }
                            else if (isActive)
                            {
                                <i class="bi bi-check-circle-fill text-danger small"></i>
                            }
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- DANH SÁCH MÓN TRÀ SỮA -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="display-1 text-muted mb-3"><i class="bi bi-cup-straw"></i></div>
            <h4 class="text-secondary fw-semibold">Chưa tìm thấy món trà sữa phù hợp</h4>
            <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc chọn danh mục "Tất Cả".</p>
            <a asp-action="Menu" class="btn btn-sakura-primary rounded-pill px-4 mt-2">Xem Tất Cả Menu</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 sakura-card">
                        <!-- Nhãn Tag Signature -->
                        <span class="sakura-tag">
                            <i class="bi bi-stars me-1"></i>Tn Signature
                        </span>

                        <!-- Hình ảnh món -->
                        <a asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none overflow-hidden">
                            <img src="@item.ImageUrl" class="card-img-top sakura-card-img" alt="@item.Name" 
                                 onerror="this.onerror=null; this.src='https://placehold.co/600x400/FBD7DC/4A202A?text=Tn+Tea';" />
                        </a>

                        <div class="card-body d-flex flex-column justify-content-between p-3">
                            <div>
                                <h5 class="card-title fw-bold mb-2" style="min-height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-reset" title="@item.Name">
                                        @item.Name
                                    </a>
                                </h5>
                                <p class="card-text text-secondary small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 40px; line-height: 1.5;">
                                    @item.Description
                                </p>
                            </div>

                            <div class="mt-3 pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="sakura-price">@item.Price.ToString("N0") đ</span>
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="small text-decoration-none fw-semibold" style="color: var(--nn-deep-rose);">
                                        Chi tiết <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>

                                <div class="d-grid gap-2">
                                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.ProductId" class="btn btn-sakura-primary text-center">
                                        <i class="bi bi-cart-plus me-1"></i> Cho vào giỏ hàng
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- THANH PHÂN TRANG (TỐI ĐA 12 SẢN PHẨM / TRANG) -->
        @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center" aria-label="Phân trang menu">
                <ul class="pagination pagination-sakura gap-1 align-items-center">
                    <!-- Nút Trang trước -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" asp-action="Menu" 
                           asp-route-page="@(ViewBag.CurrentPage - 1)" 
                           asp-route-category="@selectedCat" 
                           asp-route-search="@searchTerm">
                            <i class="bi bi-chevron-left me-1"></i>Trước
                        </a>
                    </li>

                    <!-- Các số trang -->
                    @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" 
                               style="width: 40px; height: 40px;" 
                               asp-action="Menu" 
                               asp-route-page="@p" 
                               asp-route-category="@selectedCat" 
                               asp-route-search="@searchTerm">
                                @p
                            </a>
                        </li>
                    }

                    <!-- Nút Trang sau -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" asp-action="Menu" 
                           asp-route-page="@(ViewBag.CurrentPage + 1)" 
                           asp-route-category="@selectedCat" 
                           asp-route-search="@searchTerm">
                            Sau<i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
