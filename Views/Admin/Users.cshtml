@model IEnumerable<WebTraSua.Models.User>

@{
    ViewData["Title"] = "Quản Lý Người Dùng & Phân Quyền - TN Tea";
}

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <span class="badge rounded-pill px-3 py-1 mb-2" style="background-color: #FDE8EA; color: #D25C70; font-weight: 700; font-size: 0.75rem; letter-spacing: 1.5px;">
                TÀI KHOẢN & PHÂN QUYỀN
            </span>
            <h2 class="font-serif fw-bold mb-0" style="color: #4A202A; font-family: 'Playfair Display', Georgia, serif;">
                Danh Sách Người Dùng
            </h2>
            <p class="text-secondary small mb-0">Quản lý toàn bộ danh sách khách hàng và quản trị viên của TN Tea</p>
        </div>
        <partial name="_AdminNav" />
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid rgba(244, 166, 178, 0.35) !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #FFF8F9; color: #4A202A; font-size: 0.85rem;">
                    <tr>
                        <th class="ps-4">HỌ VÀ TÊN</th>
                        <th>EMAIL</th>
                        <th>SỐ ĐIỆN THOẠI</th>
                        <th>VAI TRÒ (ROLE)</th>
                        <th>NGÀY TẠO</th>
                        <th class="text-end pe-4">SỐ ĐƠN ĐÃ ĐẶT</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var isAdmin = u.Role == "Admin";
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" 
                                         style="width: 38px; height: 38px; background: @(isAdmin ? "#EE8698" : "#A29BFE"); font-size: 0.9rem;">
                                        @(string.IsNullOrEmpty(u.FullName) ? "U" : u.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="color: #4A202A;">@u.FullName</div>
                                        <small class="text-muted">Mã: #@u.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <code>@u.Email</code>
                            </td>
                            <td>@(string.IsNullOrEmpty(u.PhoneNumber) ? "Chưa cung cấp" : u.PhoneNumber)</td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">
                                        <i class="bi bi-person-fill me-1"></i> Customer
                                    </span>
                                }
                            </td>
                            <td class="text-secondary small">
                                @u.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge bg-light text-dark border">
                                    @(u.Orders?.Count ?? 0) đơn hàng
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
