@{
    ViewData["Title"] = "Cửa Hàng TN Tea";
}

<div class="contact-hero-section position-relative overflow-hidden mb-4">
    <div class="container py-4 text-center">
        <span class="badge rounded-pill px-3 py-1 text-uppercase mb-2" style="background-color: var(--nn-soft-pink); color: var(--nn-deep-rose); font-weight: 700; font-size: 0.75rem; letter-spacing: 1.5px;">
            <i class="bi bi-geo-alt-fill me-1"></i> Không Gian Thưởng Trà
        </span>
        <h1 class="display-6 font-serif fw-bold mb-2" style="color: var(--nn-plum-text);">Cửa Hàng TN Tea</h1>
        <div class="sakura-divider"></div>
        <p class="text-secondary mx-auto mb-0" style="max-width: 650px; font-size: 0.95rem; line-height: 1.7;">
            Chào mừng bạn đến với không gian thưởng trà Sakura Pastel nhẹ nhàng, thanh tao. Hãy ghé thăm để thưởng thức những ly trà sữa tươi thơm ngon tròn vị và tận hưởng phút giây thư giãn.
        </p>
    </div>
</div>

<div class="container mb-5">
    <!-- DẢI THÔNG TIN HOTLINE & DỊCH VỤ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 h-100 text-center" style="background: #FFFFFF; border: 1px solid var(--nn-card-border) !important;">
                <div class="contact-icon-box mx-auto mb-2">
                    <i class="bi bi-telephone-fill fs-4" style="color: var(--nn-deep-rose);"></i>
                </div>
                <h6 class="fw-bold mb-1" style="color: var(--nn-plum-text);">Hotline Đặt Hàng</h6>
                <p class="fw-bold fs-5 mb-0" style="color: var(--nn-deep-rose);">1900 6868</p>
                <small class="text-muted" style="font-size: 0.75rem;">Hỗ trợ 8:00 - 22:30 mỗi ngày</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 h-100 text-center" style="background: #FFFFFF; border: 1px solid var(--nn-card-border) !important;">
                <div class="contact-icon-box mx-auto mb-2">
                    <i class="bi bi-envelope-fill fs-4" style="color: var(--nn-deep-rose);"></i>
                </div>
                <h6 class="fw-bold mb-1" style="color: var(--nn-plum-text);">Hòm Thư Điện Tử</h6>
                <p class="fw-semibold text-truncate mb-0 small" style="color: var(--nn-deep-rose);">2400001956@nttu.edu.vn</p>
                <small class="text-muted" style="font-size: 0.75rem;">support@tntea.vn</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 h-100 text-center" style="background: #FFFFFF; border: 1px solid var(--nn-card-border) !important;">
                <div class="contact-icon-box mx-auto mb-2">
                    <i class="bi bi-clock-fill fs-4" style="color: var(--nn-deep-rose);"></i>
                </div>
                <h6 class="fw-bold mb-1" style="color: var(--nn-plum-text);">Giờ Mở Cửa</h6>
                <p class="fw-bold mb-0" style="color: var(--nn-plum-text);">08:00 - 22:30</p>
                <small class="text-success fw-semibold" style="font-size: 0.75rem;"><i class="bi bi-dot"></i> Đang mở cửa đón khách</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 h-100 text-center" style="background: #FFFFFF; border: 1px solid var(--nn-card-border) !important;">
                <div class="contact-icon-box mx-auto mb-2">
                    <i class="bi bi-share-fill fs-4" style="color: var(--nn-deep-rose);"></i>
                </div>
                <h6 class="fw-bold mb-2" style="color: var(--nn-plum-text);">Mạng Xã Hội</h6>
                <div class="d-flex justify-content-center gap-3 fs-5" style="color: var(--nn-deep-rose);">
                    <a href="https://www.facebook.com/profile.php?id=61595837752936" target="_blank" rel="noopener noreferrer" class="text-reset" title="Facebook TN Tea"><i class="bi bi-facebook"></i></a>
                    <a href="https://www.tiktok.com/@@tn.tea6?lang=vi-VN" target="_blank" rel="noopener noreferrer" class="text-reset" title="TikTok TN Tea"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI 1 CƠ SỞ CỬA HÀNG & BẢN ĐỒ CHỈ ĐƯỜNG -->
    <div class="row g-4 align-items-stretch">
        <!-- Cột trái: Thông tin cơ sở cửa hàng -->
        <div class="col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm h-100 p-4 p-md-4 d-flex flex-column justify-content-between" style="background: linear-gradient(180deg, #FFFFFF 0%, #FFF5F7 100%); border: 1px solid var(--nn-card-border) !important;">
                <div>
                    <div class="mb-3">
                        <span class="badge rounded-pill px-3 py-1" style="background: linear-gradient(135deg, #EE8698 0%, #D25C70 100%); color: white; font-weight: 700; font-size: 0.75rem; letter-spacing: 1px;">
                            FLAGSHIP STORE
                        </span>
                    </div>

                    <h3 class="fw-bold mb-2 font-serif" style="color: var(--nn-plum-text);">
                        Cửa Hàng TN Tea
                    </h3>
                    <p class="text-danger fw-semibold mb-3">
                        <i class="bi bi-geo-alt-fill me-1"></i> An Phú Đông, TP. Hồ Chí Minh
                    </p>

                    <div class="p-3 rounded-3 mb-3" style="background-color: #FFFFFF; border: 1px dashed #F4A6B2;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-pin-map-fill text-danger fs-5 mt-1"></i>
                            <div>
                                <span class="text-muted small d-block">Địa chỉ cửa hàng:</span>
                                <strong style="color: var(--nn-plum-text); font-size: 0.95rem; line-height: 1.5;">
                                    Đỗ Mười/331A-331B An Phú Đông 10, An Phú Đông, Hồ Chí Minh, Việt Nam
                                </strong>
                            </div>
                        </div>
                    </div>

                    <ul class="list-unstyled small text-secondary mb-4">
                        <li class="mb-2 d-flex align-items-center">
                            <i class="bi bi-telephone-fill text-danger me-2"></i>
                            <span><strong>Hotline:</strong> 1900 6868 (Cước gọi 1.000đ/phút)</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="bi bi-clock-fill text-danger me-2"></i>
                            <span><strong>Giờ phục vụ:</strong> 08:00 - 22:30 (Thứ Hai - Chủ Nhật)</span>
                        </li>
                        <li class="d-flex align-items-center">
                            <i class="bi bi-cup-hot-fill text-danger me-2"></i>
                            <span><strong>Dịch vụ:</strong> Dùng tại quán • Mang về • Đặt giao hàng</span>
                        </li>
                    </ul>

                    <h6 class="fw-bold small mb-2" style="color: var(--nn-plum-text);">Tiện ích tại cửa hàng:</h6>
                    <div class="d-flex flex-wrap gap-1 mb-4">
                        <span class="badge bg-white text-secondary border rounded-pill py-1.5 px-2.5"><i class="bi bi-snow text-primary me-1"></i>Máy lạnh mát mẻ</span>
                        <span class="badge bg-white text-secondary border rounded-pill py-1.5 px-2.5"><i class="bi bi-wifi text-success me-1"></i>Wi-Fi tốc độ cao</span>
                        <span class="badge bg-white text-secondary border rounded-pill py-1.5 px-2.5"><i class="bi bi-p-square text-info me-1"></i>Chỗ đỗ xe rộng rãi</span>
                        <span class="badge bg-white text-secondary border rounded-pill py-1.5 px-2.5"><i class="bi bi-qr-code text-danger me-1"></i>Thanh toán QR / Thẻ</span>
                        <span class="badge bg-white text-secondary border rounded-pill py-1.5 px-2.5"><i class="bi bi-camera text-warning me-1"></i>Check-in Sakura</span>
                    </div>
                </div>

                <div class="d-flex gap-2 pt-2 border-top">
                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold flex-fill small" id="hotlineBtn" data-bs-toggle="modal" data-bs-target="#hotlineModal">
                        <i class="bi bi-telephone-fill me-1"></i> <span id="hotlineBtnText">Gọi Hotline</span>
                    </button>
                    <a href="https://maps.google.com/?q=331A+An+Phú+Đông+10+An+Phú+Đông+Hồ+Chí+Minh" target="_blank" class="btn text-white rounded-pill px-3 py-2 fw-semibold flex-fill small shadow-sm" style="background: linear-gradient(135deg, #EE8698 0%, #E87A90 100%);">
                        <i class="bi bi-map-fill me-1"></i> Chỉ Đường Maps
                    </a>
                </div>
            </div>
        </div>

        <!-- Cột phải: Bản đồ vị trí Google Maps -->
        <div class="col-lg-7">
            <div class="card border-0 rounded-4 shadow-sm h-100 overflow-hidden d-flex flex-column" style="background: #FFFFFF; border: 1px solid var(--nn-card-border) !important;">
                <div class="card-header bg-white border-bottom p-3 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0 font-serif" style="color: var(--nn-plum-text);">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> Bản Đồ Trực Tuyến
                        </h6>
                        <small class="text-secondary">Đỗ Mười/331A-331B An Phú Đông 10, An Phú Đông, TP. HCM</small>
                    </div>
                    <a href="https://maps.google.com/?q=331A+An+Phú+Đông+10+An+Phú+Đông+Hồ+Chí+Minh" target="_blank" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Mở Bản Đồ Lớn
                    </a>
                </div>
                <div class="flex-grow-1 position-relative" style="min-height: 460px;">
                    <iframe 
                        src="https://maps.google.com/maps?q=331A+An+Ph%C3%BA+%C4%90%C3%B4ng+10,+An+Ph%C3%BA+%C4%90%C3%B4ng,+H%E1%BB%93+Ch%C3%AD+Minh&t=&z=16&ie=UTF8&iwloc=&output=embed" 
                        class="w-100 h-100 position-absolute top-0 start-0"
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Hiển Thị Số Điện Thoại Hotline -->
<div class="modal fade" id="hotlineModal" tabindex="-1" aria-labelledby="hotlineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow text-center p-3" style="background: #FFFFFF; border: 1px solid var(--nn-card-border) !important;">
            <div class="modal-body p-3">
                <div class="contact-icon-box mx-auto mb-3" style="width: 58px; height: 58px;">
                    <i class="bi bi-telephone-fill fs-3" style="color: var(--nn-deep-rose);"></i>
                </div>
                <h6 class="text-secondary small mb-1" id="hotlineModalLabel">Số Điện Thoại Hotline</h6>
                <div class="py-2 px-3 my-2 rounded-4" style="background: linear-gradient(135deg, #FFF0F3 0%, #FDE4E8 100%); border: 1px solid rgba(244, 166, 178, 0.5);">
                    <span class="d-inline-block" style="font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 1.85rem; font-weight: 800; color: #D25C70; letter-spacing: 3px; line-height: 1.2;">
                        1900 6868
                    </span>
                </div>
                <p class="text-muted small mb-3">
                    Phục vụ 08:00 - 22:30 mỗi ngày<br />
                    <span style="font-size: 0.75rem;">(Cước gọi 1.000đ/phút)</span>
                </p>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-outline-danger rounded-pill py-2 fw-semibold small" id="copyPhoneBtn" onclick="copyHotline()">
                        <i class="bi bi-clipboard me-1"></i> <span id="copyPhoneText">Sao chép số</span>
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill py-1.5 fw-semibold small bg-light text-secondary border-0" data-bs-dismiss="modal">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyHotline() {
        navigator.clipboard.writeText("19006868").then(() => {
            const copyText = document.getElementById("copyPhoneText");
            if (copyText) {
                copyText.textContent = "Đã sao chép 1900 6868!";
                setTimeout(() => {
                    copyText.textContent = "Sao chép số";
                }, 2000);
            }
        });
    }

    const hotlineBtn = document.getElementById("hotlineBtn");
    const hotlineBtnText = document.getElementById("hotlineBtnText");
    if (hotlineBtn) {
        hotlineBtn.addEventListener("click", function() {
            if (hotlineBtnText) {
                hotlineBtnText.textContent = "1900 6868";
            }
            this.classList.remove("btn-outline-danger");
            this.classList.add("btn-danger", "text-white");
        });
    }
</script>
