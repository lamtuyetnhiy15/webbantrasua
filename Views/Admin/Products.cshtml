@model IEnumerable<WebTraSua.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm - TN Tea";
}

<div class="container my-5">
    <!-- Header Quản lý -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <span class="badge rounded-pill px-3 py-1 mb-2" style="background-color: #FDE8EA; color: #D25C70; font-weight: 700; font-size: 0.75rem; letter-spacing: 1.5px;">
                DANH MỤC TRÀ SỮA
            </span>
            <h2 class="font-serif fw-bold mb-0" style="color: #4A202A; font-family: 'Playfair Display', Georgia, serif;">
                Quản Lý Sản Phẩm & Món
            </h2>
            <p class="text-secondary small mb-0">Quản lý toàn bộ danh sách menu trà sữa đang mở bán tại TN Tea</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <!-- Nút Thêm Món Mới -->
            <a asp-action="CreateProduct" class="btn text-white rounded-pill px-3 py-2 fw-semibold shadow-sm" 
               style="background: linear-gradient(135deg, #EE8698 0%, #E87A90 100%);">
                <i class="bi bi-plus-circle me-1"></i> Thêm Món Mới
            </a>
            <!-- Quản lý Món: Đang ở trang này -> Tô đậm nền hồng -->
            <a asp-action="Products" class="btn text-white rounded-pill px-3 py-2 fw-semibold shadow-sm" style="background: #EE8698;">
                <i class="bi bi-cup-hot me-1"></i> Quản lý Món
            </a>
            <!-- Quản lý Đơn hàng: Để dạng viền -->
            <a asp-action="Orders" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-receipt me-1"></i> Quản lý Đơn hàng
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Bảng danh sách sản phẩm -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid rgba(244, 166, 178, 0.35) !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #FFF8F9; color: #4A202A; font-size: 0.85rem;">
                    <tr>
                        <th class="ps-4" style="width: 80px;">HÌNH ẢNH</th>
                        <th>TÊN MÓN TRÀ SỮA</th>
                        <th>ĐƠN GIÁ</th>
                        <th>MÔ TẢ CHI TIẾT</th>
                        <th class="text-end pe-4" style="width: 220px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@p.ImageUrl" alt="@p.Name" style="width: 55px; height: 55px; object-fit: cover; border-radius: 12px; border: 1px solid #FDE8EA;" 
                                         onerror="this.src='https://placehold.co/100x100/FBD7DC/4A202A?text=TN+Tea';" />
                                </td>
                                <td>
                                    <div class="fw-bold" style="color: #4A202A;">@p.Name</div>
                                    <small class="text-muted">Mã món: #@p.ProductId</small>
                                </td>
                                <td class="fw-bold text-danger">@p.Price.ToString("N0") đ</td>
                                <td class="small text-secondary" style="max-width: 320px;">
                                    <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @p.Description
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <!-- Nút Sửa -->
                                        <a asp-action="EditProduct" asp-route-id="@p.ProductId" 
                                           class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="Chỉnh sửa món">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>

                                        <!-- Nút Xóa -->
                                        <form asp-action="DeleteProduct" asp-route-id="@p.ProductId" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa món \'@p.Name\' không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="Xóa món">
                                                <i class="bi bi-trash3 me-1"></i> Xóa
                                            </button>
                                        </form>

                                        <!-- Nút Xem chi tiết -->
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId" 
                                           class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" title="Xem chi tiết ngoài web">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                Chưa có sản phẩm nào. Hãy bấm "Thêm Món Mới" để bắt đầu!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
