@model WebTraSua.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký Tài Khoản - TN Tea";
}

<div class="container my-5 py-3">
    <div class="row justify-content-center">
        <div class="col-11 col-sm-9 col-md-7 col-lg-6 col-xl-5">
            <!-- Thẻ Card đăng ký phong cách TN Tea Sakura -->
            <div class="card border-0 shadow-lg p-4 p-md-5" style="background: #FFFFFF; border-radius: 16px; border: 1px solid rgba(244, 166, 178, 0.35); box-shadow: 0 12px 35px rgba(238, 134, 152, 0.15) !important;">
                
                <!-- Header Logo & Tiêu đề -->
                <div class="text-center mb-4">
                    <img src="~/images/logo.jpg" alt="TN Tea Logo" class="mb-3 shadow-sm" 
                         style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #FFF8F9; box-shadow: 0 4px 12px rgba(238, 134, 152, 0.25);" />
                    <span class="d-block badge rounded-pill px-3 py-1 mb-2 mx-auto" 
                          style="width: fit-content; background-color: #FDE8EA; color: #D25C70; font-weight: 700; font-size: 0.75rem; letter-spacing: 1.5px;">
                        THÀNH VIÊN MỚI
                    </span>
                    <h2 class="font-serif fw-bold mb-1" style="color: #4A202A; font-family: 'Playfair Display', Georgia, serif;">Đăng Ký Tài Khoản</h2>
                    <p class="text-secondary small mb-0">Trở thành thành viên TN Tea để nhận nhiều ưu đãi đặc quyền</p>
                </div>

                <!-- Thông báo lỗi chung nếu có -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small rounded-3 border-0 mb-3" role="alert" style="background-color: #FDE8EA; color: #B71C1C;">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Họ và tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold small text-secondary">Họ và tên</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #F8D7DC;">
                                <i class="bi bi-person-fill text-muted"></i>
                            </span>
                            <input asp-for="FullName" class="form-control border-start-0" placeholder="Nguyễn Văn A" 
                                   autofocus style="border-color: #F8D7DC;" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary">Địa chỉ Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #F8D7DC;">
                                <i class="bi bi-envelope-fill text-muted"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="vidu@gmail.com" 
                                   style="border-color: #F8D7DC;" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Số điện thoại -->
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small text-secondary">Số điện thoại nhận hàng</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #F8D7DC;">
                                <i class="bi bi-telephone-fill text-muted"></i>
                            </span>
                            <input asp-for="PhoneNumber" class="form-control border-start-0" placeholder="0901234567" 
                                   style="border-color: #F8D7DC;" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small text-secondary">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #F8D7DC;">
                                <i class="bi bi-lock-fill text-muted"></i>
                            </span>
                            <input asp-for="Password" class="form-control border-start-0" placeholder="Tối thiểu 6 ký tự..." 
                                   style="border-color: #F8D7DC;" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Xác nhận mật khẩu -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary">Xác nhận mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: #F8D7DC;">
                                <i class="bi bi-shield-lock-fill text-muted"></i>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Nhập lại mật khẩu..." 
                                   style="border-color: #F8D7DC;" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Nút Đăng ký -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn text-white py-2 fw-semibold rounded-pill shadow-sm" 
                                style="background: linear-gradient(135deg, #EE8698 0%, #E87A90 100%); border: none; transition: all 0.3s ease;">
                            <i class="bi bi-person-plus-fill me-1"></i> Tạo Tài Khoản Khách Hàng
                        </button>
                    </div>
                </form>

                <!-- Link quay lại Đăng nhập -->
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="small text-secondary mb-0">
                        Đã có tài khoản TN Tea? 
                        <a asp-action="Login" class="fw-bold text-decoration-none" style="color: #EE8698;">Đăng nhập ngay</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
