@model IEnumerable<WebTraSua.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm - TN Tea";
}

<div class="container my-5">
    <!-- Header Quản lý -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <span class="badge rounded-pill px-3 py-1 mb-2" style="background-color: #FDE8EA; color: #D25C70; font-weight: 700; font-size: 0.75rem; letter-spacing: 1.5px;">
                DANH MỤC TRÀ SỮA
            </span>
            <h2 class="font-serif fw-bold mb-0" style="color: #4A202A; font-family: 'Playfair Display', Georgia, serif;">
                Quản Lý Sản Phẩm & Món
            </h2>
            <p class="text-secondary small mb-0">Quản lý toàn bộ danh sách menu trà sữa đang mở bán tại TN Tea</p>
        </div>
        <partial name="_AdminNav" />
    </div>

    <!-- Thanh thao tác bổ trợ -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-secondary small">Tổng số món: <strong>@(Model?.Count() ?? 0)</strong> sản phẩm</span>
        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1.5 fw-semibold" data-bs-toggle="modal" data-bs-target="#categoryModal">
            <i class="bi bi-journal-bookmark-fill me-1"></i> Quản Lý Mục Lục Món
        </button>
    </div>

    <!-- Bảng danh sách sản phẩm -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid rgba(244, 166, 178, 0.35) !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #FFF8F9; color: #4A202A; font-size: 0.85rem;">
                    <tr>
                        <th class="ps-4" style="width: 90px;">HÌNH ẢNH</th>
                        <th>TÊN MÓN TRÀ SỮA</th>
                        <th>MỤC LỤC</th>
                        <th>ĐƠN GIÁ</th>
                        <th>MÔ TẢ CHI TIẾT</th>
                        <th class="text-end pe-4" style="width: 220px;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="position-relative d-inline-block">
                                        <img src="@p.ImageUrl" alt="@p.Name" style="width: 55px; height: 55px; object-fit: cover; border-radius: 12px; border: 1px solid #FDE8EA;" 
                                             onerror="this.src='https://placehold.co/100x100/FBD7DC/4A202A?text=TN+Tea';" />
                                        @if (!string.IsNullOrWhiteSpace(p.Badge))
                                        {
                                            <span class="position-absolute badge rounded-pill" style="top: -6px; left: -6px; background-color: #EE8698; font-size: 0.6rem; letter-spacing: 0.5px;">@p.Badge</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold" style="color: #4A202A;">@p.Name</div>
                                    <small class="text-muted">Mã món: #@p.ProductId</small>
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-2.5 py-1.5" style="background-color: #FDE8EA; color: #D25C70; font-weight: 600; font-size: 0.78rem;">
                                        <i class="bi bi-tag-fill me-1"></i>@(string.IsNullOrWhiteSpace(p.Category) ? "Trà Sữa Đậm Hương" : p.Category)
                                    </span>
                                </td>
                                <td class="fw-bold text-danger">@p.Price.ToString("N0") đ</td>
                                <td class="small text-secondary" style="max-width: 280px;">
                                    <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @p.Description
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <!-- Nút Sửa -->
                                        <a asp-action="EditProduct" asp-route-id="@p.ProductId" 
                                           class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" title="Chỉnh sửa món">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>

                                        <!-- Nút Xóa -->
                                        <form asp-action="DeleteProduct" asp-route-id="@p.ProductId" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa món \'@p.Name\' không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" title="Xóa món">
                                                <i class="bi bi-trash3 me-1"></i> Xóa
                                            </button>
                                        </form>

                                        <!-- Nút Xem chi tiết -->
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId" 
                                           class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" title="Xem chi tiết ngoài web">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Chưa có sản phẩm nào. Hãy bấm "Thêm Món Mới" để bắt đầu!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Quản Lý Mục Lục -->
<partial name="_CategoryModal" />

@section Scripts {
    <script>
        const newCategoryInput = document.getElementById('newCategoryInput');
        const btnAddCategory = document.getElementById('btnAddCategory');
        const addCategoryMsg = document.getElementById('addCategoryMsg');
        const categoryListContainer = document.getElementById('categoryListContainer');

        function loadCategories() {
            fetch('/Admin/GetCategories')
                .then(res => res.json())
                .then(data => renderCategoryList(data))
                .catch(err => console.error('Lỗi tải mục lục:', err));
        }

        function renderCategoryList(categories) {
            if (!categoryListContainer) return;
            categoryListContainer.innerHTML = '';
            if (!categories || categories.length === 0) {
                categoryListContainer.innerHTML = '<div class="text-center py-2 text-muted small">Chưa có mục lục nào</div>';
                return;
            }
            categories.forEach(c => {
                const item = document.createElement('div');
                item.className = 'list-group-item d-flex justify-content-between align-items-center py-2 px-3 border-light';
                item.id = `cat-item-${c.id}`;
                item.innerHTML = `
                    <span class="cat-name-display fw-semibold text-dark small">${escapeHtml(c.name)}</span>
                    <div class="cat-actions d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill small btn-edit-cat" data-id="${c.id}">
                            <i class="bi bi-pencil"></i> Sửa
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill small btn-delete-cat" data-id="${c.id}" data-name="${escapeHtml(c.name)}">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                    <div class="cat-edit-form d-none w-100">
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control form-control-sm edit-cat-input" value="${escapeHtml(c.name)}" />
                            <button type="button" class="btn btn-success btn-sm btn-save-cat" data-id="${c.id}"><i class="bi bi-check-lg"></i> Lưu</button>
                            <button type="button" class="btn btn-secondary btn-sm btn-cancel-cat" data-id="${c.id}"><i class="bi bi-x-lg"></i> Hủy</button>
                        </div>
                    </div>
                `;
                categoryListContainer.appendChild(item);
            });

            attachCatEventListeners();
        }

        function attachCatEventListeners() {
            document.querySelectorAll('.btn-edit-cat').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const row = document.getElementById(`cat-item-${id}`);
                    row.querySelector('.cat-name-display').classList.add('d-none');
                    row.querySelector('.cat-actions').classList.add('d-none');
                    row.querySelector('.cat-edit-form').classList.remove('d-none');
                });
            });

            document.querySelectorAll('.btn-cancel-cat').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const row = document.getElementById(`cat-item-${id}`);
                    row.querySelector('.cat-name-display').classList.remove('d-none');
                    row.querySelector('.cat-actions').classList.remove('d-none');
                    row.querySelector('.cat-edit-form').classList.add('d-none');
                });
            });

            document.querySelectorAll('.btn-save-cat').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = parseInt(this.getAttribute('data-id'));
                    const row = document.getElementById(`cat-item-${id}`);
                    const newName = row.querySelector('.edit-cat-input').value.trim();
                    if (!newName) {
                        alert('Tên mục lục không được để trống!');
                        return;
                    }

                    fetch('/Admin/EditCategory', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: id, newName: newName })
                    })
                    .then(res => res.json())
                    .then(res => {
                        if (res.success) {
                            loadCategories();
                            // Tải lại trang sau khi sửa tên danh mục để cập nhật bảng
                            window.location.reload();
                        } else {
                            alert(res.message || 'Lỗi khi sửa mục lục');
                        }
                    });
                });
            });

            document.querySelectorAll('.btn-delete-cat').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = parseInt(this.getAttribute('data-id'));
                    const name = this.getAttribute('data-name');
                    if (confirm(`Bạn có chắc muốn xóa mục lục "${name}"?`)) {
                        fetch('/Admin/DeleteCategory', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: id })
                        })
                        .then(res => res.json())
                        .then(res => {
                            if (res.success) {
                                loadCategories();
                            } else {
                                alert(res.message || 'Lỗi khi xóa mục lục');
                            }
                        });
                    }
                });
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        if (btnAddCategory) {
            btnAddCategory.addEventListener('click', function() {
                const name = newCategoryInput.value.trim();
                if (!name) {
                    addCategoryMsg.innerHTML = '<span class="text-danger">Vui lòng nhập tên mục lục mới!</span>';
                    return;
                }

                fetch('/Admin/AddCategory', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: name })
                })
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        addCategoryMsg.innerHTML = '<span class="text-success">Đã tạo mục lục mới thành công!</span>';
                        newCategoryInput.value = '';
                        loadCategories();
                    } else {
                        addCategoryMsg.innerHTML = `<span class="text-danger">${res.message || 'Lỗi khi tạo mục lục!'}</span>`;
                    }
                })
                .catch(() => {
                    addCategoryMsg.innerHTML = '<span class="text-danger">Lỗi kết nối máy chủ!</span>';
                });
            });
        }

        const categoryModal = document.getElementById('categoryModal');
        if (categoryModal) {
            categoryModal.addEventListener('show.bs.modal', function() {
                if (addCategoryMsg) addCategoryMsg.innerHTML = '';
                if (newCategoryInput) newCategoryInput.value = '';
                loadCategories();
            });
        }
    </script>
}
